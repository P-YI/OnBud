{
  "$schema": "https://opencode.ai/config.json",
  // OnBud hybrid agent — global so AFM is available in every project.
  // Source of truth for prompts/policies: ~/OnBud/adaptive-coding-agent (git). Backup of the
  // previous (empty) file: ~/OnBud/runtime/reports/opencode.jsonc.global-backup-*
  // Providers shown in the model picker. A provider signed in with `opencode auth login` (or OAuth in the
  // desktop app) stays hidden until it is listed here.
  "enabled_providers": ["afm", "afm-agent", "openai", "github-copilot", "opencode"],
  "default_agent": "afm",
  // The v2 desktop app starts new sessions with the top-level model rather than default_agent,
  // so the default model is the AFM controller too. codex keeps GPT-6.1 Sol via its own agent model.
  "model": "afm-agent/afm-controller",
  "small_model": "afm/apple-foundationmodel",
  "provider": {
    "afm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Apple Foundation Model (on-device)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "{file:~/OnBud/config/apfel.token}"
      },
      "models": {
        "apple-foundationmodel": {
          "name": "AFM on-device (raw)",
          "limit": { "context": 8192, "output": 2048 },
          "tool_call": false
        }
      }
    },
    "afm-agent": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AFM agent (OnBud controller)",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "apiKey": "{file:~/OnBud/config/apfel.token}"
      },
      "models": {
        "afm-controller": {
          "name": "AFM agent (local)",
          // Not AFM's 8k window: the controller builds its own bounded context per turn (last turns +
          // ≤5.5k-token capsule). Declaring 8k made OpenCode auto-compact after one long answer,
          // because it counts its own ~12.5k-char system prompt against this limit.
          "limit": { "context": 200000, "output": 4096 },
          "tool_call": false
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -r *": "deny",
      "sudo *": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git checkout -- *": "deny",
      "chmod -R*": "deny",
      "chown -R*": "deny",
      "dd *": "deny",
      "diskutil *": "deny",
      "security *": "deny",
      "* | sh": "deny",
      "* | bash": "deny",
      "* | zsh": "deny",
      "cat .env*": "deny",
      "cat ~/.ssh/*": "deny",
      "ls*": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rg *": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "ask"
  },
  // Local AFM tools for frontier agents (codex): document reading/OCR, finder, on-device summaries and
  // drafts, offline LaTeX checks. Read-only; the afm/afm-local agents have their tools disabled anyway.
  "mcp": {
    "onbud": {
      "type": "local",
      "command": ["/bin/bash", "{env:HOME}/OnBud/adaptive-coding-agent/scripts/node-run.sh", "{env:HOME}/OnBud/adaptive-coding-agent/bin/afm-mcp-server.ts"],
      "enabled": true,
      "timeout": 120000
    }
  },
  "agent": {
    "afm": {
      "description": "On-device AFM agent: searches the project (rg/git/Spotlight), answers small tasks locally, tells you when to switch to codex.",
      "mode": "primary",
      "model": "afm-agent/afm-controller",
      "prompt": "Handled by the local AFM controller.",
      "tools": { "*": false }
    },
    "codex": {
      "description": "Frontier coding agent: GPT-6.1 Sol via ChatGPT Pro subscription (Codex usage).",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    },
    // GitHub Copilot: no agent yet. Copilot Free/Student plans are Auto-only: every model reports
    // model_picker_enabled=false, so OpenCode 2.2.5 lists none (shared service) or refuses them ("not available for
    // integrator opencode"). An agent on github-copilot/auto silently fell back to the default model (AFM), so it
    // is left out until OpenCode ships auto (PR #55960; also #57956, issue #34644). Then add:
    //   "copilot": { "description": "GitHub Copilot (Auto)", "mode": "primary", "model": "github-copilot/auto" },
    // Until then the credit-free route is VS Code: ask the afm agent "copilot에게 보내줘" (code chat, Auto), or use
    // inline and next-edit suggestions in the editor.
    "codex-handoff": {
      "description": "Read-only Codex used when you approve an AFM hand-off. Cannot edit files or run arbitrary commands.",
      "mode": "primary",
      "hidden": true,
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": { "*": "deny", "ls*": "allow", "pwd": "allow", "git status*": "allow", "git diff*": "allow", "git log*": "allow", "rg *": "allow" }
      }
    },
    // Lean code agent for AFM hand-offs that only need code back (no tools, one-line prompt): the
    // codex-handoff agent's tool definitions and system prompt are ~5k input tokens per call.
    "codex-solve": {
      "description": "Code-only Codex for AFM hand-offs: returns code, no tools.",
      "mode": "primary",
      "hidden": true,
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "prompt": "You write correct, complete code. Reply with only the code block asked for.",
      "tools": { "*": false }
    },
    // The code skill's cheap tier (default GPT-6.1 Terra, listed at about half Sol's price; pick another model in
    // Spotlight > Backend > Routing): its answer is kept only when a check passes (the examples, or agreement with
    // Copilot's code); otherwise codex-solve answers. Named for the role so a model change needs no rename.
    "codex-solve-cheap": {
      "description": "Code-only, cheaper model (checked escalations).",
      "mode": "primary",
      "hidden": true,
      "model": "openai/gpt-6.1-terra",
      "variant": "medium",
      "prompt": "You write correct, complete code. Reply with only the code block asked for.",
      "tools": { "*": false }
    },
    // Experiment (code benchmark only): Codex leads and has Copilot write routine functions through afm_code, to
    // see whether delegating the code it would print saves output tokens. Not used by OnBud itself.
    "codex-lead": {
      "description": "Code-only Codex that delegates routine functions to Copilot (afm_code); benchmark experiment.",
      "mode": "primary",
      "hidden": true,
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "prompt": "You write correct, complete code. For routine functions whose behaviour you can state in a sentence, call the onbud_afm_code tool (folder and path are given in the task) and use its proposed code if it is right; write tricky logic yourself. Reply with only the final complete code block.",
      "tools": { "*": false, "onbud_afm_code": true }
    },
    "afm-local": {
      "description": "Short, bounded tasks on the on-device Apple model. No tools.",
      "mode": "primary",
      "model": "afm/apple-foundationmodel",
      "prompt": "{file:~/OnBud/adaptive-coding-agent/policies/AFM.md}",
      "temperature": 0,
      "tools": { "*": false }
    },
    "build": { "variant": "medium" },
    "plan": { "variant": "medium" }
  }
}
